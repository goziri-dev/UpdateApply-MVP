{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UpdateApply",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file",
        "${workspaceFolder}/app/.env"
      ]
    },
    {
      "name": "UpdateApply (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file",
        "${workspaceFolder}/app/.env",
        "--web-port",
        "5173"
      ]
    },
    {
      "name": "UpdateApply (Chrome, no debug — F5-safe)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "chrome",
      "noDebug": true,
      "toolArgs": [
        "--dart-define-from-file",
        "${workspaceFolder}/app/.env",
        "--web-port",
        "5173"
      ]
    },
    {
      "name": "UpdateApply (Web Server — use normal Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "web-server",
      "toolArgs": [
        "--dart-define-from-file",
        "${workspaceFolder}/app/.env",
        "--web-hostname",
        "localhost",
        "--web-port",
        "5173"
      ]
    }
  ]
}
