{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UpdateApply (Chrome) — recommended",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "noDebug": true,
      "toolArgs": [
        "--dart-define-from-file=.env",
        "--web-port=5173"
      ]
    },
    {
      "name": "UpdateApply web",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "noDebug": true,
      "toolArgs": [
        "--dart-define-from-file=.env",
        "--web-port=5173"
      ]
    },
    {
      "name": "UpdateApply (Chrome + debugger)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=.env",
        "--web-port=5173"
      ]
    },
    {
      "name": "UpdateApply (Web Server — use normal Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "toolArgs": [
        "--dart-define-from-file=.env",
        "--web-hostname=localhost",
        "--web-port=5173"
      ]
    },
    {
      "name": "UpdateApply (pick device)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=.env"
      ]
    }
  ]
}
