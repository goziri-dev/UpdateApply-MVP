APP_NAME=UpdateApply
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Secret (verify user access tokens on the API)
SUPABASE_JWT_SECRET=

# Supabase Postgres — Project Settings → Database → Connection string
# Prefer Transaction pooler (port 6543) for the API; use Direct (5432) for Alembic if needed.
# Replace [YOUR-PASSWORD] and host from the dashboard. Keep the +psycopg driver prefix.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# OpenRouter via langchain-openrouter (endpoint is built into the library)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OAuth (Google, GitHub, Notion) is configured in the Supabase Dashboard
# → Authentication → Providers — not in this file.
