APP_NAME=UpdateApply
APP_HOST=0.0.0.0
APP_PORT=8000
# Include every Flutter web origin you use (flutter run -d chrome port varies).
CORS_ORIGINS=https://app.updateapply.com,https://www.updateapply.com,https://updateapply.com,http://localhost:3000,http://localhost:8080,http://localhost:5000,http://127.0.0.1:5000

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Never ship to Flutter / commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Secret (HS256 verify). Prefer JWKS when enabled.
SUPABASE_JWT_SECRET=

# Supabase Postgres — Project Settings → Database → Connect
# Prefer Session pooler (5432) or Transaction pooler (6543); avoid db.*.supabase.co if
# it is IPv6-only. URL-encode special chars in the password (# → %23, @ → %40, ^ → %5E).
# Keep the +psycopg driver prefix for SQLAlchemy.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# OpenRouter via langchain-openrouter (endpoint is built into the library)
OPENROUTER_API_KEY=
# Legacy fallback default. Per-task defaults live in app.core.llm_tasks;
# optional overrides below (empty → DEFAULT_MODEL_BY_TASK).
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL_RESUME_EXTRACT=google/gemini-2.5-flash
# OPENROUTER_MODEL_INTERVIEW_QUESTIONS=google/gemini-2.5-flash
# OPENROUTER_MODEL_PROFILE_REVIEW=openai/gpt-4o-mini
# OPENROUTER_MODEL_RESUME_TAILOR=openai/gpt-4o-mini
# Resume edit harness (default google/gemini-2.5-flash — format-following, not premium)
# OPENROUTER_MODEL_RESUME_EDIT=google/gemini-2.5-flash
# pgvector RAG embeddings (default openai/text-embedding-3-small, 1536 dims)
# OPENROUTER_MODEL_EMBEDDING=openai/text-embedding-3-small
# Interview mic: OpenRouter STT (default openai/whisper-1)
# OPENROUTER_MODEL_INTERVIEW_TRANSCRIBE=openai/whisper-1

# Required for resume Ask mode (live web search); omit → Ask returns a clear 400. Edit still works.
# TAVILY_API_KEY=

# Local onboarding PDF storage (default: server/data/uploads/{user_id}/resume.pdf)
# RESUME_UPLOAD_DIR=
# Offline click-through only. Leave false so /parse never returns demo data.
# ALLOW_STUB_PARSE=false

# ATS catalog ingest — polite per-host pause; no user id on ingest.
# INGEST_HOST_PAUSE_SECONDS=0.75
# INGEST_FAILURE_THRESHOLD=3
# INGEST_DESCRIPTION_MAX_CHARS=50000
# INGEST_HTTP_TIMEOUT_SECONDS=30

# Phase 3 daily run — prefer cron: `uv run updateapply-catalog daily`
# ENABLE_DAILY_JOB_RUNNER=false
# DAILY_JOB_RUNNER_HOUR_UTC=6
# Notify Decision: cap 3 / floor 0.35 / in-app log + optional webhook
# NOTIFY_DAILY_CAP=3
# NOTIFY_SIMILARITY_FLOOR=0.35
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TIMEOUT_SECONDS=10

# OAuth (Google for v1) is configured in the Supabase Dashboard
# → Authentication → Providers — not in this file.
# Protected API routes expect: Authorization: Bearer <supabase_access_token>
# GET /api/v1/auth/me verifies the JWT and upserts the app `user` row (id = auth.users.id / JWT sub).
# Onboarding hard gate: user.onboarding_status (not_started|in_progress|complete).
# After schema changes: cd server && uv run alembic upgrade head
#
# Public waitlist (no auth): POST /api/v1/waitlist
#   { "name", "email", "career_stage", "job_search_challenges"?, "source"? }
# Writes to public.waitlist_signup via DATABASE_URL. Does not create sessions or allowlist rows.
# Landing proxies via WAITLIST_API_URL=https://api.updateapply.com/api/v1/waitlist
#
# Google Sheet sync via Composio (best-effort on signup; empty → skip):
# WAITLIST_GOOGLE_SHEET_ID=   # from docs.google.com/spreadsheets/d/<ID>/edit
# WAITLIST_GOOGLE_SHEET_RANGE=Sheet1!A:H
# COMPOSIO_API_KEY=
# COMPOSIO_GOOGLE_SHEETS_ACCOUNT_ID=
#
# --- Private beta allowlist + Favour notify ---
# Shared secret for admin routes (list/approve waitlist, manage allowlist).
# Header: X-Admin-Key: <value>
# ADMIN_API_KEY=
#
# Resend (https://resend.com) — transactional email. You do NOT need Microsoft 365.
# 1) Create API key in Resend
# 2) Verify domain updateapply.com (DNS: SPF/DKIM in Resend dashboard)
# 3) Set from-address on that domain
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=UpdateApply <noreply@updateapply.com>
# ADMIN_NOTIFY_EMAIL=your@email.com
# APP_PUBLIC_URL=https://app.updateapply.com
# API_PUBLIC_URL=https://api.updateapply.com
# Optional Slack/Discord incoming webhook (in addition to Resend):
# WAITLIST_NOTIFY_WEBHOOK_URL=
#
# Day-to-day: Favour gets an email with one-click Approve / Reject links
# (HMAC-signed GET, 7-day TTL; no ADMIN_API_KEY in the email).
# Fallback curl still works:
#   curl -s 'https://api.updateapply.com/api/v1/admin/waitlist?status=pending' \
#     -H "X-Admin-Key: $ADMIN_API_KEY"
#   curl -s -X POST "https://api.updateapply.com/api/v1/admin/waitlist/<id>/approve" \
#     -H "X-Admin-Key: $ADMIN_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"notify_user": true}'
#   curl -s -X POST "https://api.updateapply.com/api/v1/admin/waitlist/<id>/reject" \
#     -H "X-Admin-Key: $ADMIN_API_KEY" -H 'Content-Type: application/json' \
#     -d '{}'
# Or add directly (skip waitlist):
#   curl -s -X POST https://api.updateapply.com/api/v1/admin/allowlist \
#     -H "X-Admin-Key: $ADMIN_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"email":"you@example.com","note":"founder","notify_user":false}'
# Or Supabase Table Editor on public.app_allowlist (email lowercase, revoked_at null).
