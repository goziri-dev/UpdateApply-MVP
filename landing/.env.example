# Public site origin (canonical + Open Graph). Production: https://updateapply.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Flutter app host linked from the footer ("Already invited?").
NEXT_PUBLIC_APP_URL=https://app.updateapply.com

# Prefer FastAPI capture once deployed (TSK-50):
# WAITLIST_API_URL=https://api.updateapply.com/api/v1/waitlist
# Local API:
# WAITLIST_API_URL=http://localhost:8000/api/v1/waitlist
WAITLIST_API_URL=

# Durable fallback when WAITLIST_API_URL is empty: server-side Supabase insert.
# Service role only — never NEXT_PUBLIC_*. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
