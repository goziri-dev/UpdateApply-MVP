API_BASE_URL=http://localhost:8000

# Supabase — Project Settings → API (public; safe for the Flutter client)
# Never put SUPABASE_SERVICE_ROLE_KEY in the Flutter app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Optional OAuth redirect override.
# Web: defaults to the current origin (add it under Authentication → URL Configuration).
# Native example: io.updateapply.app://login-callback/
SUPABASE_AUTH_REDIRECT_URL=

# Load into Flutter with:
#   flutter run -d chrome --dart-define-from-file=.env
#
# Also add redirect URLs in Supabase Dashboard → Authentication → URL Configuration:
#   http://localhost:* (or your flutter web origin)
#   io.updateapply.app://login-callback/
#
# Enable providers: Authentication → Providers → Google, GitHub, Notion
