API_BASE_URL=http://localhost:8000

# Supabase — Project Settings → API (public; safe for the Flutter client)
# Never put SUPABASE_SERVICE_ROLE_KEY in the Flutter app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Optional OAuth redirect override.
# Web: leave empty — app uses Uri.base.origin (same-tab PKCE callback).
# Native example: io.updateapply.app://login-callback/
SUPABASE_AUTH_REDIRECT_URL=

# Load into Flutter with a pinned web port so Dashboard URLs stay stable:
#   flutter run -d chrome --web-port=5000 --dart-define-from-file=.env
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:        http://localhost:5000
#   Redirect URLs:   http://localhost:5000
#                    io.updateapply.app://login-callback/   (native)
#   (+ production https origins when you deploy)
#
# Enable providers: Authentication → Providers → Google, GitHub, Notion
# Also enable Email if using email/password in the auth UI.
