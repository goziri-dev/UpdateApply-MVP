{
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!robots\\.txt).*)", "destination": "/index.html" }]
}
